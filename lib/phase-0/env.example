# Qloo: use the exact URLs validated against the active API documentation.
QLOO_BASE_URL=
QLOO_API_KEY=
QLOO_SEARCH_URL=
QLOO_TAGS_URL=
QLOO_INSIGHTS_URL=
QLOO_COMPARE_URL=
QLOO_TRENDS_URL=
QLOO_SEARCH_QUERY=Nike
QLOO_SEARCH_TYPES=urn:entity:brand
QLOO_SEARCH_TAKE=5
QLOO_INSIGHTS_FILTER_TYPE=urn:tag
QLOO_INSIGHTS_LOCATION_QUERY=India
QLOO_INSIGHTS_TAKE=10
QLOO_TIMEOUT_MS=20000
QLOO_CACHE_ENABLED=false
QLOO_CREATOR_ENRICH_LIMIT=20
QLOO_ENABLE_HEATMAP=false
QLOO_HEATMAP_BOUNDARY=geohash
QLOO_HEATMAP_TAKE=100

# OpenRouter / AI SDK (server-side only)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3.8-27b:free
ENABLE_MODEL_SEARCH_PLAN=false
ENABLE_MODEL_REPORTS=false

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Required only for privileged server-side operations; never expose publicly.
SUPABASE_SERVICE_ROLE_KEY=
# Required only for database administration/migrations, not app requests.
DB_PASSWORD=

# Apify / Influship
APIFY_API_TOKEN=
APIFY_ACTOR_ID=influship~influencer-search
APIFY_TIMEOUT_MS=30000
APIFY_RUN_TIMEOUT_SECONDS=300
APIFY_MAX_ITEMS=100
APIFY_MAX_TOTAL_CHARGE_USD=5
APIFY_START_LEASE_MS=120000
APIFY_WEBHOOK_SECRET=

# Provider retention and workflow controls
PROVIDER_RETAIN_RAW=false
PROVIDER_RAW_RETENTION_DAYS=7
MAX_ANALYSIS_ATTEMPTS=3
MAX_ANALYSIS_RUNTIME_MS=900000

# Optional spike controls
PHASE0_APIFY_QUERY=
PHASE0_APIFY_TIMEOUT_SECONDS=180
