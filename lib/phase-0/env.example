# Qloo: use the exact URLs validated against the active API documentation.
QLOO_BASE_URL=
QLOO_API_KEY=
QLOO_SEARCH_URL=
QLOO_INSIGHTS_URL=
QLOO_SEARCH_QUERY=Nike
QLOO_SEARCH_TYPES=urn:entity:brand
QLOO_SEARCH_TAKE=5
QLOO_INSIGHTS_FILTER_TYPE=urn:tag
QLOO_INSIGHTS_LOCATION_QUERY=India
QLOO_INSIGHTS_TAKE=10

# OpenRouter / AI SDK (server-side only)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3.8-27b:free

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Required only for privileged server-side operations; never expose publicly.
SUPABASE_SERVICE_ROLE_KEY=
# Required only for database administration/migrations, not app requests.
DB_PASSWORD=

# Apify / Influship
APIFY_API_TOKEN=

# Optional spike controls
PHASE0_APIFY_QUERY=
PHASE0_APIFY_TIMEOUT_SECONDS=180
